{
  "name": "pixwarden-js",
  "version": "0.1.0",
  "description": "Bounded structural inspection primitives for untrusted image data",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "files": ["dist", "README.md", "SECURITY.md", "LICENSE"],
