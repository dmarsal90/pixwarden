{
  "name": "pixwarden-js",
  "version": "0.1.0",
  "description": "Bounded structural inspection primitives for untrusted image data",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.tests.json",
    "pretest": "npm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@jazzer.js/core": "^4.0.0",
    "@types/node": "26.6.6",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "saxes": "6.0.0"
  }
}
