{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pixwarden:spec:0.1.0",
  "title": "Pixwarden shared contracts",
  "description": "Strict JSON contracts for interoperable Pixwarden requests, policies and reports. Semantic invariants are additionally enforced by each runtime.",
  "$defs": {
    "Verdict": { "type": "string", "enum": ["allow", "sanitize", "reject", "review"] },
    "ControlStatus": { "type": "string", "enum": ["passed", "failed", "skipped", "unsupported", "error"] },
    "Severity": { "type": "string", "enum": ["info", "low", "medium", "high", "critical"] },
    "Format": { "type": "string", "enum": ["jpeg", "png", "gif", "webp", "svg", "bmp", "avif", "heif", "heic", "jxl", "tiff", "bigtiff", "psd", "psb", "openexr", "svgz", "eps", "ai", "ico", "cur", "icns", "apng", "dicom", "geotiff", "tga", "pcx", "pdf", "xps", "unknown"] },
    "Stage": { "type": "string", "enum": ["receive", "identify", "structural", "metadata", "active_content", "binary", "steganography", "resource", "decode", "sanitize", "ai", "postcheck", "policy", "report"] },
    "ControlResult": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "summary"],
      "properties": { "status": { "$ref": "#/$defs/ControlStatus" }, "summary": { "type": "string", "maxLength": 500 } }
    },
    "ScanHints": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "filename": { "type": "string", "maxLength": 255, "pattern": "^[^\\u0000-\\u001f\\u007f]*$" },
        "mediaType": { "type": "string", "maxLength": 127, "pattern": "^[^\\u0000-\\u001f\\u007f]*$" }
      },
      "anyOf": [{ "required": ["filename"] }, { "required": ["mediaType"] }]
    },
    "ResourceLimits": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "maxBytes": { "type": "integer", "minimum": 1 },
        "maxWidth": { "type": "integer", "minimum": 1 },
        "maxHeight": { "type": "integer", "minimum": 1 },
        "maxPixels": { "type": "integer", "minimum": 1 },
        "maxFrames": { "type": "integer", "minimum": 1 },
        "maxMetadataBytes": { "type": "integer", "minimum": 1 },
        "maxMetadataEntries": { "type": "integer", "minimum": 1 },
        "maxNestingDepth": { "type": "integer", "minimum": 1 },
        "maxWallTimeMs": { "type": "integer", "minimum": 1 },
        "maxMemoryBytes": { "type": "integer", "minimum": 1 },
        "maxConcurrency": { "type": "integer", "minimum": 1 },
        "enforcement": { "type": "string", "enum": ["in_process", "worker", "container"] }
      }
    },
    "ScanOptions": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "structural": { "type": "boolean" }, "metadata": { "type": "boolean" },
        "binaryInspection": { "type": "boolean" }, "sanitize": { "type": "boolean" },
        "hints": { "$ref": "#/$defs/ScanHints" }, "limits": { "$ref": "#/$defs/ResourceLimits" },
        "steganography": {
          "type": "object", "additionalProperties": false, "required": ["enabled", "mode"],
          "properties": { "enabled": { "type": "boolean" }, "mode": { "type": "string", "enum": ["statistical", "targeted"] }, "maxSamples": { "type": "integer", "minimum": 1 } }
        },
        "aiInspection": {
          "type": "object", "additionalProperties": false, "required": ["enabled", "ocr"],
          "properties": { "enabled": { "type": "boolean" }, "ocr": { "type": "boolean" }, "adapterId": { "type": "string", "minLength": 1, "maxLength": 128 } }
        },
        "policyId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "requiredControls": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_-]{0,63}$" } },
        "unsupportedFormat": { "type": "string", "enum": ["review", "reject"] },
        "incompleteAnalysis": { "type": "string", "enum": ["review", "reject"] }
      }
    },
    "ScanRequest": {
      "type": "object", "additionalProperties": false, "required": ["requestVersion", "input", "options"],
      "properties": {
        "requestVersion": { "const": 1 },
        "input": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["base64"], "properties": { "base64": { "type": "string", "contentEncoding": "base64", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" } } },
            { "type": "object", "additionalProperties": false, "required": ["inputRef"], "properties": { "inputRef": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*://).+$" } } }
          ]
        },
        "options": { "$ref": "#/$defs/ScanOptions" }, "hints": { "$ref": "#/$defs/ScanHints" }
      }
    },
    "Evidence": {
      "type": "object", "additionalProperties": false, "required": ["kind", "summary"],
      "properties": {
        "kind": { "type": "string", "enum": ["offset", "range", "signature", "statistic", "metadata_tag", "text_signal", "decoder", "policy", "digest"] },
        "summary": { "type": "string", "maxLength": 500 }, "offset": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 0 }, "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "redactedValue": { "type": "string", "maxLength": 500 },
        "attributes": { "type": "object", "maxProperties": 16, "additionalProperties": { "type": ["string", "number", "integer", "boolean", "null"] } }
      },
      "allOf": [{ "if": { "properties": { "kind": { "const": "range" } }, "required": ["kind"] }, "then": { "required": ["offset", "length"] } }]
    },
    "Finding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "severity", "stage", "title", "description", "status", "controlStatus", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^(?:[A-Z]{2,8}-[0-9]{3}|EXT-[a-z0-9][a-z0-9-]{0,31}-[A-Z0-9][A-Z0-9_-]{0,63})$" },
        "severity": { "$ref": "#/$defs/Severity" }, "stage": { "$ref": "#/$defs/Stage" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 }, "description": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["confirmed", "suspected", "inconclusive"] },
        "controlStatus": { "$ref": "#/$defs/ControlStatus" }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/Evidence" } }
      }
    },
    "SecurityPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["policyVersion", "id", "requiredControls", "unsupportedFormat", "incompleteAnalysis", "unknownFinding", "severityThresholds", "metadataAction", "svgAction", "sanitizationFailure", "allowOnlyIfAllRequiredPassed"],
      "properties": {
        "policyVersion": { "const": 1 }, "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "requiredControls": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "unsupportedFormat": { "type": "string", "enum": ["review", "reject"] }, "incompleteAnalysis": { "type": "string", "enum": ["review", "reject"] },
        "unknownFinding": { "type": "string", "enum": ["review", "reject"] },
        "severityThresholds": { "type": "object", "additionalProperties": false, "required": ["allow", "sanitize", "reject", "review"], "properties": { "allow": { "$ref": "#/$defs/Severity" }, "sanitize": { "$ref": "#/$defs/Severity" }, "reject": { "$ref": "#/$defs/Severity" }, "review": { "$ref": "#/$defs/Severity" } } },
        "metadataAction": { "type": "string", "enum": ["preserve", "strip", "reject"] }, "svgAction": { "type": "string", "enum": ["sanitize", "reject"] },
        "sanitizationFailure": { "type": "string", "enum": ["review", "reject"] }, "allowOnlyIfAllRequiredPassed": { "type": "boolean" }
      }
    },
    "SanitizationResult": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status", "sourceDigest"], "properties": { "status": { "const": "not_requested" }, "sourceDigest": { "$ref": "#/$defs/Digest" } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "sourceDigest", "artifactDigest", "format", "bytes", "transformations", "postCheckStatus"], "properties": { "status": { "const": "produced" }, "sourceDigest": { "$ref": "#/$defs/Digest" }, "artifactDigest": { "$ref": "#/$defs/Digest" }, "format": { "$ref": "#/$defs/Format" }, "bytes": { "type": "integer", "minimum": 0 }, "transformations": { "type": "array", "items": { "type": "string", "maxLength": 128 } }, "postCheckStatus": { "$ref": "#/$defs/ControlStatus" } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "sourceDigest"], "properties": { "status": { "enum": ["failed", "unsupported"] }, "sourceDigest": { "$ref": "#/$defs/Digest" } } }
      ]
    },
    "BinaryInspectionResult": {
      "type": "object", "additionalProperties": false, "required": ["status", "bytesScanned", "findings", "trailingData", "recursiveInspection"],
      "properties": { "status": { "type": "string", "enum": ["passed", "findings", "unsupported", "error"] }, "bytesScanned": { "type": "integer", "minimum": 0 }, "findings": { "type": "array", "items": { "$ref": "#/$defs/Finding" } }, "trailingData": { "type": "boolean" }, "recursiveInspection": { "const": false } }
    },
    "SteganographyResult": {
      "type": "object", "additionalProperties": false, "required": ["status", "methods", "limitations"],
      "properties": {
        "status": { "type": "string", "enum": ["passed", "anomalous", "inconclusive", "unsupported", "error"] },
        "methods": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "applicable", "status"], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 128 }, "applicable": { "type": "boolean" }, "status": { "$ref": "#/$defs/ControlStatus" }, "samples": { "type": "integer", "minimum": 0 }, "score": { "type": "number" } } } },
        "limitations": { "type": "array", "items": { "type": "string", "maxLength": 1000 } }
      }
    },
    "AiInspectionResult": {
      "type": "object", "additionalProperties": false, "required": ["status", "dataEgress", "signals", "limitations"],
      "properties": { "status": { "type": "string", "enum": ["not_requested", "completed", "partial", "unsupported", "error"] }, "adapterId": { "type": "string", "maxLength": 128 }, "dataEgress": { "type": "string", "enum": ["none", "local", "remote"] }, "signals": { "type": "array", "items": { "$ref": "#/$defs/Finding" } }, "limitations": { "type": "array", "items": { "type": "string", "maxLength": 1000 } } }
    },
    "CapabilityReport": {
      "type": "object", "additionalProperties": false, "required": ["runtime", "runtimeVersion", "engineVersion", "specVersion", "formats", "optionalAdapters", "hardLimits", "networkAccess"],
      "properties": {
        "runtime": { "type": "string", "enum": ["node", "php"] }, "runtimeVersion": { "type": "string", "maxLength": 64 }, "engineVersion": { "type": "string", "maxLength": 64 }, "specVersion": { "type": "string", "maxLength": 64 },
        "formats": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": false, "required": ["inspect", "decode", "sanitize", "reason"], "properties": { "inspect": { "type": "boolean" }, "decode": { "type": "boolean" }, "sanitize": { "type": "boolean" }, "reason": { "type": "string", "maxLength": 500 } } } },
        "optionalAdapters": { "type": "object", "additionalProperties": { "type": "boolean" } }, "hardLimits": { "type": "object", "additionalProperties": { "type": "boolean" } }, "networkAccess": { "const": false }
      }
    },
    "EngineError": {
      "type": "object", "additionalProperties": false, "required": ["code", "stage", "message", "retryable", "fatal", "controlStatus"],
      "properties": { "code": { "type": "string", "enum": ["INVALID_OPTIONS", "INPUT_TOO_LARGE", "LIMIT_EXCEEDED", "UNSUPPORTED_FORMAT", "UNSUPPORTED_CAPABILITY", "MALFORMED_INPUT", "DECODER_FAILURE", "TIMEOUT", "CANCELLED", "IO_FAILURE", "POLICY_FAILURE", "SANITIZATION_FAILURE", "INTERNAL_ERROR"] }, "stage": { "$ref": "#/$defs/Stage" }, "message": { "type": "string", "maxLength": 500 }, "retryable": { "type": "boolean" }, "fatal": { "type": "boolean" }, "controlStatus": { "$ref": "#/$defs/ControlStatus" }, "limitName": { "type": "string", "maxLength": 64 }, "observed": { "type": "integer", "minimum": 0 }, "maximum": { "type": "integer", "minimum": 0 }, "correlationId": { "type": "string", "maxLength": 128 } }
    },
    "Digest": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
    "ScanResult": {
      "type": "object", "additionalProperties": false,
      "required": ["resultVersion", "scanId", "engineVersion", "specVersion", "startedAt", "completedAt", "format", "validity", "decodability", "sanitized", "policyCompliant", "coverage", "verdict", "controls", "findings", "capabilities", "limitations", "inputBytes"],
      "properties": {
        "resultVersion": { "const": 1 }, "scanId": { "type": "string", "format": "uuid" }, "engineVersion": { "type": "string", "maxLength": 64 }, "specVersion": { "type": "string", "maxLength": 64 },
        "startedAt": { "type": "string", "format": "date-time" }, "completedAt": { "type": "string", "format": "date-time" }, "format": { "$ref": "#/$defs/Format" },
        "validity": { "type": "string", "enum": ["valid", "invalid", "unknown"] }, "decodability": { "type": "string", "enum": ["decoded", "not_attempted", "failed", "unsupported"] },
        "sanitized": { "type": "boolean" }, "policyCompliant": { "type": "boolean" }, "coverage": { "type": "string", "enum": ["complete", "partial", "incomplete"] }, "verdict": { "$ref": "#/$defs/Verdict" },
        "controls": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/ControlResult" } }, "findings": { "type": "array", "items": { "$ref": "#/$defs/Finding" } },
        "capabilities": { "$ref": "#/$defs/CapabilityReport" }, "limitations": { "type": "array", "items": { "type": "string", "maxLength": 1000 } },
        "inputBytes": { "type": "integer", "minimum": 0 }, "inputDigest": { "$ref": "#/$defs/Digest" }, "sanitization": { "$ref": "#/$defs/SanitizationResult" },
        "binaryInspection": { "$ref": "#/$defs/BinaryInspectionResult" }, "steganography": { "$ref": "#/$defs/SteganographyResult" }, "aiInspection": { "$ref": "#/$defs/AiInspectionResult" }
      }
    }
  }
}
